# Copy to .env and fill in. NONE of these is a secret — the GHL token is the
# only secret and it is set separately with:
#     firebase functions:secrets:set GHL_TOKEN
#
# .env is gitignored, but it would be safe to commit; keeping it out is just
# hygiene so nobody gets in the habit of putting the token here.

# Firebase web API key — the same public value that is already in config.js.
# Used to ask Google whether a caller's dashboard sign-in is real.
FIREBASE_API_KEY=

# The GHL sub-account the four calendars belong to.
GHL_LOCATION_ID=

# Comma-separated allowlist of calendar ids. A calendar not named here cannot
# be read or booked through this function, no matter who is signed in. This is
# what stops a dashboard login being a general way into the GHL account.
CALENDAR_IDS=

# The page the dashboard is embedded on. "*" works but means any site can call
# this with a valid dashboard login.
ALLOWED_ORIGIN=https://salesbysummit.com
