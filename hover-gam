
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Neon Racer - Multiplayer</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@400;700;900&display=swap" rel="stylesheet">
    <style>
        body, html {
            margin: 0; padding: 0; width: 100%; height: 100%;
            background-color: #050510; overflow: hidden;
            font-family: 'Orbitron', sans-serif; touch-action: none;
            user-select: none; -webkit-user-select: none;
        }
        canvas { display: block; width: 100%; height: 100%; }
        
        #ui-layer {
            position: absolute; top: 0; left: 0; width: 100%; height: 100%;
            pointer-events: none; display: flex; flex-direction: column;
            justify-content: center; align-items: center; z-index: 10;
        }
        .pointer-events-auto { pointer-events: auto; }
        
        /* Neon Text Utilities */
        .neon-text-cyan { color: #fff; text-shadow: 0 0 5px #fff, 0 0 10px #fff, 0 0 20px #0ff, 0 0 40px #0ff; }
        .neon-text-pink { color: #fff; text-shadow: 0 0 5px #fff, 0 0 10px #fff, 0 0 20px #f0f, 0 0 40px #f0f; }
        .neon-text-yellow { color: #fff; text-shadow: 0 0 5px #fff, 0 0 10px #fff, 0 0 20px #ff0, 0 0 40px #ff0; }
        .neon-text-red { color: #fff; text-shadow: 0 0 5px #fff, 0 0 10px #fff, 0 0 20px #f00, 0 0 40px #f00; }
        
        /* Neon Buttons */
        .neon-btn {
            background: rgba(0, 20, 20, 0.6); color: #fff; border: 2px solid #0ff;
            box-shadow: 0 0 10px #0ff, inset 0 0 10px #0ff; transition: all 0.2s ease-in-out;
            text-shadow: 0 0 5px #fff, 0 0 10px #0ff; backdrop-filter: blur(4px);
        }
        .neon-btn:hover:not(:disabled), .neon-btn:active:not(:disabled) {
            background: rgba(0, 255, 255, 0.2); box-shadow: 0 0 20px #0ff, inset 0 0 20px #0ff; transform: scale(1.05);
        }
        .neon-btn:disabled { border-color: #555; box-shadow: none; color: #777; cursor: not-allowed; }
        .neon-btn-pink { border-color: #f0f; box-shadow: 0 0 10px #f0f, inset 0 0 10px #f0f; text-shadow: 0 0 5px #fff, 0 0 10px #f0f; }
        .neon-btn-pink:hover:not(:disabled) { background: rgba(255, 0, 255, 0.2); box-shadow: 0 0 20px #f0f, inset 0 0 20px #f0f; }
        
        /* Effects */
        .scanlines {
            position: fixed; top: 0; left: 0; width: 100vw; height: 100vh;
            background: linear-gradient(to bottom, rgba(255,255,255,0), rgba(255,255,255,0) 50%, rgba(0,0,0,0.2) 50%, rgba(0,0,0,0.2));
            background-size: 100% 4px; pointer-events: none; z-index: 20; opacity: 0.6;
        }
        .vignette {
            position: fixed; top: 0; left: 0; width: 100vw; height: 100vh;
            box-shadow: 0 0 150px rgba(0,0,0,0.9) inset; pointer-events: none; z-index: 15;
        }
        .hidden { display: none !important; }
        
        /* Mobile Controls */
        .mobile-controls {
            position: absolute; bottom: 20px; width: 100%; px-4;
            display: flex; justify-content: space-between; z-index: 25;
            pointer-events: none;
        }
        .control-btn {
            width: 70px; height: 70px; background: rgba(0, 255, 255, 0.1);
            border: 2px solid rgba(0, 255, 255, 0.5); border-radius: 50%;
            display: flex; justify-content: center; align-items: center;
            color: rgba(0, 255, 255, 0.8); font-size: 24px; font-weight: bold;
            pointer-events: auto; backdrop-filter: blur(5px); transition: background 0.1s;
        }
        .control-btn:active { background: rgba(0, 255, 255, 0.4); box-shadow: 0 0 15px #0ff; }
        .control-btn.btn-gas { width: 90px; height: 90px; border-color: rgba(255, 0, 255, 0.5); color: rgba(255, 0, 255, 0.8); background: rgba(255, 0, 255, 0.1); }
        .control-btn.btn-gas:active { background: rgba(255, 0, 255, 0.4); box-shadow: 0 0 15px #f0f; }
        
        @media (min-width: 768px) { .mobile-controls { display: none; } }
    </style>
</head>
<body>
    <div class="scanlines"></div>
    <div class="vignette"></div>
    <canvas id="gameCanvas"></canvas>

    <div id="ui-layer">
        <!-- Main Menu -->
        <div id="menu-screen" class="flex flex-col items-center pointer-events-auto bg-black/60 p-8 rounded-3xl backdrop-blur-md border border-cyan-500/30">
            <h1 class="text-5xl md:text-7xl font-black mb-2 neon-text-cyan tracking-wider text-center italic">NEON</h1>
            <h1 class="text-5xl md:text-7xl font-black mb-8 neon-text-pink tracking-wider text-center italic">RACER</h1>
            <p class="text-gray-400 mb-8 text-sm md:text-base tracking-widest uppercase text-center">
